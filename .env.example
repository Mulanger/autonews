NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Public canonical URLs. Keep this as the website origin for indexed articles.
PUBLIC_SITE_URL=https://www.polywhaletrades.com

# Existing Polywhale services.
API_BASE_URL=https://whaleserver-production.up.railway.app
MONGO_URI=mongodb://localhost:27017/polywatch
MONGO_DB=polywatch
REDIS_URL=redis://localhost:6379
WHALE_CHANNEL=whales
RESOLUTION_CHANNEL=market_resolutions

# MiniMax. Do not commit real keys.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
AI_GENERATION_ENABLED=true
AI_REQUIRE_SUCCESS=false

# Thresholds.
TRADE_NEWS_MIN_USD=100000
LOSS_NEWS_MIN_USD=200000

# Worker controls.
WORKER_ENABLED=true
REDIS_SUBSCRIBER_ENABLED=true
BACKFILL_ENABLED=true
BACKFILL_INTERVAL_MS=60000
BACKFILL_LIMIT=100
MAX_ARTICLES_PER_BACKFILL=20

# Optional write hook auth for direct test/future webhook ingestion.
INGEST_SECRET=
CORS_ORIGINS=https://www.polywhaletrades.com,http://127.0.0.1:3000,http://localhost:3000

